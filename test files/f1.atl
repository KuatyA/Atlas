    //statements and functions
    insert_keyword("if", TOKEN_KW_IF);
    insert_keyword("else", TOKEN_KW_ELSE);
    insert_keyword("while", TOKEN_KW_WHILE);
    insert_keyword("do", TOKEN_KW_DO);
