    FILE *atl_file = fopen(filetype, "rb");
    //check empty
    if(atl_file == NULL){
        fprintf(stderr, "ERROR: Could not open file!");
        return;
    }
    //initialize string buf and index.
    char string_buf[256];
    int buf_idx = 0;